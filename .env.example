# ---------------------------------------------------------------------------
# BufferInc environment configuration
# Copy to `.env.local` and fill in. Nothing here is required for the site to
# build or render — the contact pipeline degrades safely when unset.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://bufferinc.example"

# --- Contact delivery -------------------------------------------------------
# Provider for contact submissions. One of: "console" | "webhook" | "resend".
# Default is "console": submissions are validated and logged server-side only,
# never transmitted. Change this only once a provider + DPA is in place.
CONTACT_PROVIDER="console"

# Used when CONTACT_PROVIDER="webhook" (e.g. a CRM inbound endpoint).
CONTACT_WEBHOOK_URL=""
CONTACT_WEBHOOK_TOKEN=""

# Used when CONTACT_PROVIDER="resend".
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""

# --- Analytics --------------------------------------------------------------
# Deliberately empty. No analytics script is loaded by default and none may be
# loaded before consent. See lib/analytics.ts.
NEXT_PUBLIC_ANALYTICS_PROVIDER=""
